# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API in the Supabase dashboard). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, used for admin tasks (moderation, audit log). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
